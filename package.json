{
  "name": "lingo-context",
  "version": "0.1.3",
  "private": true,
  "description": "Chrome/Yandex/Opera extension: context-aware page translation via LLM or free MT services, with PDF export.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "icons": "node scripts/icons.mjs",
    "package": "node scripts/package.mjs",
    "encoding": "node scripts/check-encoding.mjs",
    "verify": "node scripts/verify.mjs",
    "release": "npm run build && npm run package"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.9.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3"
  }
}
